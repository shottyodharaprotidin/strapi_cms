# =============================================================================
# STRAPI CMS — Environment Configuration Example
# Copy this file to .env and fill in the values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# Public-facing URL of this Strapi instance (used in admin panel links, emails)
PUBLIC_URL=https://app.shottyodharaprotidin.com
# Admin panel URL path (default: /admin)
STRAPI_ADMIN_URL=/admin
# Set to true on Windows local dev to skip heavy plugins (comments, publisher, redis)
LOCAL_LITE_MODE=true

# -----------------------------------------------------------------------------
# Security / Secrets  ← MUST be replaced with strong random values in production
# -----------------------------------------------------------------------------
# 4 comma-separated base64 keys, e.g.: node -e "console.log([...Array(4)].map(()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
APP_KEYS=change_me_key1,change_me_key2,change_me_key3,change_me_key4
API_TOKEN_SALT=change_me_random_salt_32chars
ADMIN_JWT_SECRET=change_me_random_admin_jwt_secret
TRANSFER_TOKEN_SALT=change_me_random_transfer_salt
JWT_SECRET=change_me_random_jwt_secret
ENCRYPTION_KEY=change_me_random_encryption_key

# -----------------------------------------------------------------------------
# Database
# Set DATABASE_CLIENT to: postgres (production) | sqlite (local dev) | mysql
# -----------------------------------------------------------------------------
DATABASE_CLIENT=postgres

# PostgreSQL (production)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change_me_db_password
DATABASE_SSL=true
# Optional: full connection string (overrides individual vars above when set)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# SQLite — local development only
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=./.tmp/data.db

# -----------------------------------------------------------------------------
# Redis Cache
# Leave REDIS_HOST unset (or use LOCAL_LITE_MODE=true) to disable Redis locally.
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=change_me_redis_password

# -----------------------------------------------------------------------------
# Email — SMTP (takes precedence over SES when SMTP_HOST is set)
# -----------------------------------------------------------------------------
SMTP_HOST=mail.shottyodharaprotidin.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@shottyodharaprotidin.com
SMTP_PASS=change_me_smtp_password
SMTP_FROM=noreply@shottyodharaprotidin.com
SMTP_REPLY_TO=support@shottyodharaprotidin.com

# -----------------------------------------------------------------------------
# Email — AWS SES (used only when SMTP_HOST is NOT set)
# -----------------------------------------------------------------------------
# AWS_SES_ACCESS_KEY_ID=change_me
# AWS_SES_SECRET_ACCESS_KEY=change_me
# AWS_SES_REGION=ap-southeast-1
# AWS_SES_DEFAULT_FROM=noreply@shottyodharaprotidin.com
# AWS_SES_DEFAULT_REPLY_TO=support@shottyodharaprotidin.com

# -----------------------------------------------------------------------------
# AWS S3 (for future migration from local file storage to S3)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=change_me
# AWS_ACCESS_SECRET=change_me
# AWS_REGION=ap-southeast-2
# AWS_BUCKET=shottyodharaprotidin-media

# -----------------------------------------------------------------------------
# Preview / Frontend integration
# PREVIEW_SECRET must match PREVIEW_SECRET in the Next.js .env
# -----------------------------------------------------------------------------
PREVIEW_FRONTEND_URL=https://shottyodharaprotidin.com
PREVIEW_SECRET=change_me_random_preview_secret

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection on comment/newsletter forms)
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# -----------------------------------------------------------------------------
CLOUDFLARE_TURNSTILE_SECRET_KEY=change_me_turnstile_secret

# -----------------------------------------------------------------------------
# Google Cloud Translation API — auto-translate bn-BD → en on article publish
# Free tier: 500,000 characters/month (no credit card until exceeded)
# Setup: https://console.cloud.google.com → APIs & Services → Cloud Translation API
# -----------------------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=change_me_google_translate_api_key
AUTO_TRANSLATE_ENABLED=true

# -----------------------------------------------------------------------------
# Admin panel feature flags (optional)
# -----------------------------------------------------------------------------
# FLAG_NPS=false
# FLAG_PROMOTE_EE=false

